DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_SECRET=replace-with-a-long-random-value
AUTH_REQUIRED=false
# Saran AI form Proses Bisnis (gratis: buat key di https://aistudio.google.com/apikey). Kosongkan untuk memakai heuristik lokal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Realtime (Pusher): buat app di https://dashboard.pusher.com. Kosongkan untuk mematikan realtime.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
# Domain produksi untuk SEO (canonical, sitemap, Open Graph), tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=https://spbe.gresikkab.go.id
